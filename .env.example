##########################################################################################
# FirmwareDroid Environment Configuration (.env.example)
#
# NOTE: This file is completely OPTIONAL.
# When starting with `docker compose up`, FirmwareDroid automatically generates all
# cryptographic secrets, passwords, and TLS certificates into an internal named Docker volume.
#
# If you create a `.env` file from this template, any values you set will override the defaults.
# DO NOT commit your live `.env` file to version control.
##########################################################################################

# Environment mode: 'production', 'development', or 'testing'
APP_ENV=development
APP_DEBUG=true

# Domain & URL settings
DOMAIN_NAME=fmd.localhost

# Django Cryptographic Secret Key
# REQUIRED if running outside Docker or overriding the auto-generated runtime secret.
# Must be a long, random string (e.g. generated via `python -c "import secrets; print(secrets.token_urlsafe(50))"`).
# DJANGO_SECRET_KEY=

# Django Admin Superuser Credentials (optional overrides)
# DJANGO_SUPERUSER_USERNAME=fmd-admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# CORS Configuration (semicolon-separated list of additional allowed hosts/domains)
# CORS_ADDITIONAL_HOST=

# Database Credentials (optional overrides)
# MONGODB_USERNAME=mongodbuser
# MONGODB_PASSWORD=
# MONGO_INITDB_ROOT_USERNAME=mongodbroot
# MONGO_INITDB_ROOT_PASSWORD=
# REDIS_PASSWORD=
# NEO4J_PASSWORD=

# Local Storage Paths (bind mounts on host filesystem, optional)
# LOCAL_STORAGE_PATH_00=
# LOCAL_STORAGE_PATH_01=
# LOCAL_STORAGE_PATH_02=
# LOCAL_STORAGE_PATH_03=
# LOCAL_STORAGE_PATH_04=
# LOCAL_STORAGE_PATH_05=
# LOCAL_STORAGE_PATH_06=
# LOCAL_STORAGE_PATH_07=
# LOCAL_STORAGE_PATH_08=
# LOCAL_STORAGE_PATH_09=
# DJANGO_SQLITE_DATABASE_MOUNT_PATH=
