ARG REGISTRY=ghcr.io
ARG IMAGE_NAME=firmwaredroid/firmwaredroid

########################################################
# Multi-stage builder for binwalk                      #
# Compiles binwalk and discards the Rust toolchain     #
########################################################
FROM rust:bookworm AS binwalk-builder
RUN apt-get update && apt-get install -y --no-install-recommends libfontconfig1-dev
RUN cargo install --root /out binwalk

########################################################
# Extractor Worker Runtime Stage                       #
########################################################
FROM ${REGISTRY}/${IMAGE_NAME}-base:latest AS extractor-worker
USER root

#####################################
# Install apt runtime dependencies  #
#####################################
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        android-sdk-libsparse-utils liblzo2-2 fuse brotli libmagic1 \
        exfat-fuse e2fsprogs f2fs-tools dosfstools erofs-utils wget xxd sudo file \
        p7zip-full unar zlib1g lzop lziprecover libhyperscan5 zstd lz4 libfontconfig1; \
    apt-get clean; rm -rf /var/lib/apt/lists/*

#####################################
# General configuration             #
#####################################
RUN echo "www ALL=(ALL) NOPASSWD: /var/www/source/extractor/mount_copy.sh * * *, /bin/cp" > /etc/sudoers.d/mount
RUN chmod +x /var/www/source/extractor/mount_copy.sh

#####################################
# Install binwalk from build stage  #
#####################################
COPY --from=binwalk-builder /out/bin/binwalk /usr/local/bin/binwalk

#####################################
# Install payload dumpers           #
#####################################
USER www
RUN git clone --depth 1 https://github.com/vm03/payload_dumper.git /opt/firmwaredroid/payload_dumper && \
    python -m venv /opt/firmwaredroid/payload_dumper/venv && \
    /opt/firmwaredroid/payload_dumper/venv/bin/pip install --no-cache-dir -r /opt/firmwaredroid/payload_dumper/requirements.txt

RUN set -eux; \
    mkdir -p /opt/firmwaredroid/payload_dumper-go; \
    wget -q https://github.com/ssut/payload-dumper-go/releases/download/1.2.2/payload-dumper-go_1.2.2_linux_amd64.tar.gz -O /tmp/payload-dumper-go.tar.gz; \
    tar -xzf /tmp/payload-dumper-go.tar.gz -C /opt/firmwaredroid/payload_dumper-go/; \
    rm -f /tmp/payload-dumper-go.tar.gz; \
    chmod +x /opt/firmwaredroid/payload_dumper-go/payload-dumper-go
ENV PATH="$PATH:/opt/firmwaredroid/payload_dumper-go"

#####################################
# Install lpunpack                  #
#####################################
RUN git clone --depth 1 https://github.com/FirmwareDroid/lpunpack.git /opt/firmwaredroid/lpunpack

#####################################
# Install python dependencies       #
# Compilers purged after build      #
#####################################
USER root
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential python3-dev liblzo2-dev zlib1g-dev libhyperscan-dev; \
    pip install --no-cache-dir -r /var/www/requirements/requirements_extractor.txt; \
    apt-get purge -y --auto-remove build-essential python3-dev liblzo2-dev zlib1g-dev libhyperscan-dev; \
    apt-get clean; rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/source/
USER www
