ARG REGISTRY=ghcr.io
ARG IMAGE_NAME=firmwaredroid/firmwaredroid

########################################################
# Multi-stage builder for Krakatau                     #
# Compiles krak2 binary and discards Rust toolchain    #
########################################################
FROM rust:bookworm AS krakatau-builder
RUN git clone --depth 1 https://github.com/Storyyeller/Krakatau.git /build/krakatau \
    && cd /build/krakatau \
    && cargo build --release

########################################################
# APK Scanner Worker Runtime Stage                     #
########################################################
FROM ${REGISTRY}/${IMAGE_NAME}-base:latest AS apk_scanner-worker

USER root

########################################################
# Copy OpenJDK 23 from Eclipse Temurin into Debian base #
########################################################
COPY --from=eclipse-temurin:23 /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"

#####################################
# Installing required packages      #
#####################################
RUN apt-get --allow-releaseinfo-change update -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

#####################################
# Install Android command line tools #
#####################################
ENV ANDROID_HOME=/android/sdk
ENV ANDROID_SDK_ROOT=/android/sdk
ENV ANDROID_AVD_HOME=/android/sdk/avd
ENV ANDROID_EMULATOR_HOME=/android/sdk/emulator
ENV ANDROID_USER_HOME=/android/user_home/
ENV PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_SDK_ROOT/build-tools/35.0.0/:$PATH

RUN set -eux; \
    mkdir -p /android/sdk/cmdline-tools/latest /android/sdk/avd /android/sdk/platforms \
             /android/sdk/platform-tools /android/sdk/system-images /android/user_home; \
    for i in $(seq 1 5); do \
        wget -q https://dl.google.com/android/repository/commandlinetools-linux-10406996_latest.zip -O /tmp/cmdline-tools.zip && break || sleep 15; \
    done; \
    for i in $(seq 1 5); do \
        wget -q https://dl.google.com/android/repository/platform-tools-latest-linux.zip -O /tmp/platform-tools.zip && break || sleep 15; \
    done; \
    unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools-unzip; \
    mv /tmp/cmdline-tools-unzip/cmdline-tools/* /android/sdk/cmdline-tools/latest/; \
    unzip -q /tmp/platform-tools.zip -d /android/sdk/; \
    rm -rf /tmp/cmdline-tools.zip /tmp/platform-tools.zip /tmp/cmdline-tools-unzip; \
    yes | /android/sdk/cmdline-tools/latest/bin/sdkmanager --licenses || true; \
    /android/sdk/cmdline-tools/latest/bin/sdkmanager --install "build-tools;35.0.0" || true; \
    chown -R www:www /android && chmod -R u+rwx /android

#####################################
# Installing apktool                #
#####################################
RUN set -eux; \
    for i in $(seq 1 5); do \
        curl -fsSLo /usr/local/bin/apktool.jar "https://github.com/iBotPeaches/Apktool/releases/download/v3.0.1/apktool_3.0.1.jar" && break || sleep 15; \
    done; \
    for i in $(seq 1 5); do \
        curl -fsSLo /usr/local/bin/apktool https://raw.githubusercontent.com/iBotPeaches/Apktool/master/scripts/linux/apktool && break || sleep 15; \
    done; \
    chmod a+x /usr/local/bin/apktool.jar /usr/local/bin/apktool; \
    apktool v

#####################################
# Installing jadx                   #
#####################################
ENV JADX="/opt/jadx/bin"
ENV PATH="${JADX}:${PATH}"
RUN set -eux; \
    mkdir -p /opt/jadx; \
    JADX_VERSION="1.5.3"; \
    for i in $(seq 1 5); do \
        curl -fsSLo /tmp/jadx.zip "https://github.com/skylot/jadx/releases/download/v1.5.3/jadx-${JADX_VERSION}.zip" && break || sleep 15; \
    done; \
    unzip -q /tmp/jadx.zip -d /opt/jadx; \
    rm -f /tmp/jadx.zip; \
    jadx --version

##################################################
# Install Java decompilers                       #
##################################################
RUN mkdir -p /opt/decompilers/java/
# Install CFR
RUN set -eux; \
    for i in $(seq 1 5); do \
        wget -q https://github.com/leibnitz27/cfr/releases/download/0.152/cfr-0.152.jar -O /opt/decompilers/java/cfr.jar && break || sleep 15; \
    done

# Install Procyon
RUN set -eux; \
    for i in $(seq 1 5); do \
        wget -q https://github.com/mstrobel/procyon/releases/download/v0.6.0/procyon-decompiler-0.6.0.jar -O /opt/decompilers/java/procyon.jar && break || sleep 15; \
    done

# Install Krakatau from builder stage
RUN mkdir -p /opt/decompilers/java/krakatau/target/release
COPY --from=krakatau-builder /build/krakatau/target/release/krak2 /opt/decompilers/java/krakatau/target/release/krak2

#####################################
# Install SUPER Android Analyzer   #
#####################################
WORKDIR /tmp
RUN set -eux; \
    for i in $(seq 1 5); do \
        wget -q -P /tmp/ https://github.com/SUPERAndroidAnalyzer/super/releases/download/0.5.1/super-analyzer_0.5.1_ubuntu_amd64.deb && break || sleep 15; \
    done; \
    dpkg -i /tmp/super-analyzer_0.5.1_ubuntu_amd64.deb || true; \
    rm -f /tmp/super-analyzer_0.5.1_ubuntu_amd64.deb

#####################################
# Install FlowDroid                 #
#####################################
RUN mkdir -p /opt/flowdroid/rules/
RUN set -eux; \
    for i in $(seq 1 5); do \
        wget -q -O /opt/flowdroid/soot-infoflow-cmd-jar-with-dependencies.jar https://github.com/secure-software-engineering/FlowDroid/releases/download/v2.13/soot-infoflow-cmd-2.13.0-jar-with-dependencies.jar && break || sleep 15; \
    done; \
    for i in $(seq 1 5); do \
        wget -q -O /opt/flowdroid/rules/SourcesAndSinks.txt https://raw.githubusercontent.com/secure-software-engineering/FlowDroid/develop/soot-infoflow-android/SourcesAndSinks.txt && break || sleep 15; \
    done; \
    for i in $(seq 1 5); do \
        wget -q -O /opt/flowdroid/rules/SourcesAndSinks_SharedPrefsOnly.txt https://raw.githubusercontent.com/secure-software-engineering/FlowDroid/develop/soot-infoflow-android/SourcesAndSinks_SharedPrefsOnly.txt && break || sleep 15; \
    done; \
    cp -r /var/www/source/static_analysis/FlowDroid/rules/* /opt/flowdroid/rules/

########################################################
# Install trufflehog (official static binary)          #
########################################################
RUN wget -qO- https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin

########################################################
# Install Python requirements                          #
########################################################
RUN pip install --no-cache-dir -r /var/www/requirements/requirements_apk_scanner.txt

##################################################
# Install python-based static-analysis tools     #
# Strict isolated virtualenv per tool            #
##################################################
USER root
RUN chown -R www:www /opt/firmwaredroid/python/

USER www
ENV PATH="$PATH:/home/www/.local/bin/"
ENV PYTHONPATH="/var/www/source/"
WORKDIR /var/www/source/
RUN python3 /var/www/docker/setup_apk_scanner.py
